<?xml version="1.0"?>
<package format="2">
  <name>fastlio_health_monitor</name>
  <version>0.2.0</version>
  <description>Reusable C++ ROS1 health monitoring, lifecycle control and trace logging.</description>
  <maintainer email="dev@example.com">FAST-LIO workspace maintainer</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>qtbase5-dev</build_depend>
  <build_export_depend>qtbase5-dev</build_export_depend>
  <exec_depend>libqt5-widgets</exec_depend>
  <exec_depend>fast_lio</exec_depend>
  <build_depend>message_generation</build_depend>
  <exec_depend>message_runtime</exec_depend>
  <depend>geometry_msgs</depend>
  <depend>yaml-cpp</depend>
  <depend>eigen</depend>
  <depend>libssl-dev</depend>
  <depend>boost</depend>
  <depend>roscpp</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>diagnostic_msgs</depend>
  <depend>std_msgs</depend>
  <depend>std_srvs</depend>
  <depend>livox_ros_driver</depend>
  <depend>pluginlib</depend>
  <depend>rviz</depend>
  <depend>rosbag</depend>
  <depend>rosgraph_msgs</depend>
  <exec_depend>tf2_ros</exec_depend>

  <export>
    <rviz plugin="${prefix}/health_panel_plugin.xml" />
  </export>
</package>
