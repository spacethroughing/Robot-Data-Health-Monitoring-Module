<launch>
  <arg name="rviz" default="true" />
  <arg name="use_sim_time" default="false" />
  <arg name="health_config" default="$(find fastlio_health_monitor)/config/health_v2_avia.yaml" />
  <arg name="data_reference" default="" />
  <arg name="rviz_config"
       default="$(find fastlio_health_monitor)/rviz/fastlio_health_v2_testbench.rviz" />

  <param name="/use_sim_time" value="$(arg use_sim_time)" />

  <include file="$(find fast_lio)/launch/mapping_avia.launch">
    <arg name="rviz" value="false" />
    <arg name="path_en" value="true" />
    <arg name="pcd_save_en" value="false" />
    <arg name="map_pub_en" value="true" />
    <arg name="map_pub_interval_sec" value="1.0" />
  </include>

  <include file="$(find fastlio_health_monitor)/launch/health_monitor_v2.launch">
    <arg name="config" value="$(arg health_config)" />
    <arg name="data_reference" value="$(arg data_reference)" />
  </include>

  <!-- Avia config/avia.yaml extrinsic_T, extrinsic_R (identity rotation). -->
  <node pkg="tf2_ros" type="static_transform_publisher" name="body_to_livox_raw"
        args="0.04165 0.02326 -0.0284 0 0 0 body livox_raw" />

  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="fastlio_health_testbench_rviz"
        args="-d $(arg rviz_config)" output="screen" />
</launch>
