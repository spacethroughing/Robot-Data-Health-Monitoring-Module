<launch>
  <arg name="rviz" default="true" />
  <arg name="rviz_config" default="$(find fastlio_health_monitor)/rviz/fastlio_health_v2_testbench.rviz" />
  <arg name="config" default="$(find fastlio_health_monitor)/config/health_v2_managed.yaml" />
  <arg name="runtime_config" default="$(find fastlio_health_monitor)/config/runtime_bag.yaml" />
  <param name="/use_sim_time" value="true" />
  <include file="$(find fastlio_health_monitor)/launch/health_monitor_v2.launch">
    <arg name="config" value="$(arg config)" />
  </include>
  <node pkg="fastlio_health_monitor" type="robot_runtime_controller_node" name="robot_runtime_controller" output="screen">
    <param name="config_file" value="$(arg runtime_config)" />
  </node>
  <node pkg="tf2_ros" type="static_transform_publisher" name="body_to_livox_raw" args="0.04165 0.02326 -0.0284 0 0 0 body livox_raw" />
  <node if="$(arg rviz)" pkg="rviz" type="rviz" name="fastlio_health_testbench_rviz" args="-d $(arg rviz_config)" output="screen" />
</launch>
