# ROS接口数据流：控制器/任务生产者 -> 消息或服务 -> 健康生命周期/规划适配器。
# 发送时间和frame信息；接收端另用单调时钟判断心跳年龄。
std_msgs/Header header
# 控制绑定名，对应模块lifecycle.control_binding。
string binding
# 内部控制器身份，用于拒绝旧控制器再次接管。
string controller_id
# 内部生产进程实例；重启后变化，避免跨实例差分；新版不写入日志。
string producer_instance_id
# 本次RUN/STOP/PAUSE操作标识，用于因果关联。
string command_id
# 单调递增心跳序号；重复/旧序号拒绝。
uint64 sequence
# 可信坐标系重置代际；未经授权的回退拒绝。
uint64 frame_epoch
# 期望状态：RUN、PAUSE或STOP。
string desired_state
# 已确认状态：STARTING/RUNNING/PAUSED/STOPPING/STOPPED/FAULT。
string observed_state
# 状态变化/故障的可读原因。
string reason
# 受管子进程退出码。
int32 exit_code
# 本次控制器运行标识，关联控制器日志。
string controller_run_id
# 控制器本次run日志目录。
string controller_log_directory
# 控制器关键日志是否正常；丢关键事件不能仍宣称可追溯。
bool trace_healthy
# 可选bag引用路径，不推测未声明的数据来源。
string data_reference
# 兼容旧消息保留；新版发送空字符串，不计算、不写日志。
string data_sha256
