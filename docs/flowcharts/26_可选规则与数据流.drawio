<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="可选规则与数据流"><mxGraphModel dx="1200" dy="1000" grid="1" page="1" pageWidth="1200" pageHeight="1600"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="a" value="YAML：各模块/检测规则显式enabled true/false；保留阈值" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="360" y="40" width="460" height="70" as="geometry" /></mxCell><mxCell id="b" value="ConfigLoader：校验 / 合并共享默认 / 过滤关闭模块" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="360" y="150" width="460" height="70" as="geometry" /></mxCell><mxCell id="c" value="InputAdapter：ROS消息 → 解包 / 基础有效性 / 单位转换 → Sample" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="360" y="270" width="460" height="80" as="geometry" /></mxCell><mxCell id="d" value="消息到达：StreamTracker.receive&#10;源stamp重复 / 倒退 / 间隔" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="420" width="330" height="90" as="geometry" /></mxCell><mxCell id="e" value="质量规则：IMU / 雷达 / 定位 / 测距&#10;只执行显式选择的阈值" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="430" y="420" width="330" height="90" as="geometry" /></mxCell><mxCell id="f" value="独立SteadyTimer：即使没消息也检查&#10;RECEIVE_AGE / 频率" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="830" y="420" width="330" height="90" as="geometry" /></mxCell><mxCell id="g" value="RuleLatch：每条规则的触发 / 保持 / 恢复" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="430" y="580" width="330" height="80" as="geometry" /></mxCell><mxCell id="h" value="RuntimeState → LifecycleTracker&#10;RUN / PAUSE / STOP / FAULT" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="30" y="700" width="330" height="90" as="geometry" /></mxCell><mxCell id="i" value="ModuleMonitor：数据健康 + 生命周期 + NO_DATA策略" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="430" y="720" width="480" height="80" as="geometry" /></mxCell><mxCell id="j" value="依赖 / 总体健康 → DiagnosticArray、UInt8 → RViz / 终端" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="430" y="860" width="480" height="80" as="geometry" /></mxCell><mxCell id="k" value="事件 / 周期指标 → 队列 → EventRecorder写线程&#10;JSONL / CSV过滤精简字段；只保留三种记录时间" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="430" y="1010" width="480" height="90" as="geometry" /></mxCell><mxCell id="l" value="验证正常EOF → finish：排空、flush/fsync、封存&#10;日志不再增长，诊断继续" style="rounded=1;whiteSpace=wrap;html=0;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=16;" vertex="1" parent="1"><mxGeometry x="430" y="1160" width="480" height="90" as="geometry" /></mxCell><mxCell id="edge0" edge="1" parent="1" source="a" target="b" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge1" edge="1" parent="1" source="b" target="c" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge2" edge="1" parent="1" source="c" target="d" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="edge3" edge="1" parent="1" source="c" target="e" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;html=0;"><mxGeometry relative="1" as="geometry" /></mxCell><mxC