digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.38", ranksep="0.48", fontname="Noto Sans CJK SC", dpi=150];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#94A3B8", penwidth=1.3, fontname="Noto Sans CJK SC", fontsize=16, margin="0.17,0.11"];
  edge [color="#64748B", fontname="Noto Sans CJK SC", fontsize=12, arrowsize=0.8];
  A [label="收到状态变化、异常和指标", fillcolor="#E0F2FE", color="#0284C7"];
  B [label="添加运行编号、模块编号和配置版本"];
  C [label="事件写入 JSONL\n指标写入 CSV"];
  D [label="文件写入正常？", shape=diamond, fillcolor="#FEF3C7", color="#D97706"];
  E [label="按编号查看事件和变化过程", fillcolor="#DCFCE7", color="#16A34A"];
  F [label="标记日志不完整\n并报告写入错误", fillcolor="#FEE2E2", color="#DC2626"];
  A -> B -> C -> D;
  D -> E [label="是"];
  D -> F [label="否"];
}
