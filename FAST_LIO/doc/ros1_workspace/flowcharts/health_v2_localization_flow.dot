digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.5", ranksep="0.65", fontname="Noto Sans CJK SC", dpi=150];
node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#4771a3", penwidth=1.4, fontname="Noto Sans CJK SC", fontsize=17, margin="0.18,0.12"];
edge [color="#53677f", fontname="Noto Sans CJK SC", fontsize=13, arrowsize=0.8];
A [label="运行状态 / 定位新消息", fillcolor="#edf4ff", shape=box];
B [label="本代际应检查新数据？（含 STARTING 样本）", fillcolor="#fff4d9", shape=diamond];
N [label="STOPPED 或 STARTING\n不提供有效定位 / 明确原因", fillcolor="#eff1f4", shape=box];
C [label="结构 / 源时间 / 坐标\n位姿 / 四元数检查", fillcolor="#edf4ff", shape=box];
D [label="硬错误？", fillcolor="#fff4d9", shape=diamond];
E [label="数据 ERROR\n丢弃坏基线 / 保留事件", fillcolor="#fde9e9", shape=box];
F [label="授权重启或坐标重置？", fillcolor="#fff4d9", shape=diamond];
R [label="新 epoch / 清派生历史\n重新收集有效连续样本", fillcolor="#eff1f4", shape=box];
G [label="独立频率 / 接收年龄\n同帧位置与旋转协方差", fillcolor="#edf4ff", shape=box];
H [label="同坐标连续样本足够？", fillcolor="#fff4d9", shape=diamond];
I [label="速度/加速度 N/A\n不把未知填成零", fillcolor="#eff1f4", shape=box];
J [label="速度向量 / 向量加速度\n四元数短弧 / 预测残差跳变", fillcolor="#edf4ff", shape=box];
K [label="YAML 阈值 / 持续与恢复\n周期最严重事件", fillcolor="#edf4ff", shape=box];
Z [label="模块报告 / 依赖汇总 / 日志", fillcolor="#e5f6ee", shape=box];
A -> B;
B -> N [label="否"];
B -> C [label="是"];
C -> D;
D -> E [label="是"];
D -> F [label="否"];
F -> R [label="是"];
F -> G [label="否"];
G -> H;
H -> I [label="否"];
H -> J [label="是"];
J -> K;
N -> Z;
E -> Z;
R -> Z;
I -> Z;
K -> Z;
}
