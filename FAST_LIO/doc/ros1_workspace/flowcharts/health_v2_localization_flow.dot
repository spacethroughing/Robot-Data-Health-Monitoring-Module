digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.38", ranksep="0.48", fontname="Noto Sans CJK SC", dpi=150];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#94A3B8", penwidth=1.3, fontname="Noto Sans CJK SC", fontsize=16, margin="0.17,0.11"];
  edge [color="#64748B", fontname="Noto Sans CJK SC", fontsize=12, arrowsize=0.8];
  A [label="读取定位运行状态", fillcolor="#E0F2FE", color="#0284C7"];
  B [label="正在运行？", shape=diamond, fillcolor="#FEF3C7", color="#D97706"];
  C [label="检查时间戳、坐标系和位姿"];
  D [label="同一坐标系的样本足够？", shape=diamond, fillcolor="#FEF3C7", color="#D97706"];
  E [label="检查速度、加速度、协方差和跳变"];
  F [label="按 YAML 阈值输出\nOK / WARNING / ERROR", fillcolor="#EDE9FE", color="#7C3AED"];
  G [label="正常停止：灰色待机\n定位暂不可用", fillcolor="#F1F5F9"];
  H [label="显示状态并记录原因", fillcolor="#DCFCE7", color="#16A34A"];
  I [label="样本不足：继续收集\n派生指标显示 N/A", fillcolor="#F1F5F9"];
  A -> B;
  B -> C [label="是"];
  B -> G [label="否"];
  C -> D;
  D -> E [label="是"];
  D -> I [label="否"];
  E -> F -> H;
  G -> H;
  I -> H;
}
