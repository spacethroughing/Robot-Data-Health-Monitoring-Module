digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.3", nodesep="0.38", ranksep="0.48", fontname="Noto Sans CJK SC", dpi=150];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#94A3B8", penwidth=1.3, fontname="Noto Sans CJK SC", fontsize=16, margin="0.17,0.11"];
  edge [color="#64748B", fontname="Noto Sans CJK SC", fontsize=12, arrowsize=0.8];
  A [label="接收 IMU 消息", fillcolor="#E0F2FE", color="#0284C7"];
  B [label="检查加速度计、陀螺仪和字段"];
  C [label="按配置统一单位\n加速度 g → m/s²；角速度 rad/s"];
  D [label="检查幅值、时间戳、频率和接收年龄"];
  E [label="按 YAML 阈值判断\n输出 OK / WARNING / ERROR", fillcolor="#EDE9FE", color="#7C3AED"];
  F [label="显示状态并记录原因\n未知协方差标为未知", fillcolor="#DCFCE7", color="#16A34A"];
  A -> B -> C -> D -> E -> F;
}
