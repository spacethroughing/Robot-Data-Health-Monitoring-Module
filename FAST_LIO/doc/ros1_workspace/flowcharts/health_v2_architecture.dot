digraph G {
graph [rankdir=LR, bgcolor="white", pad="0.35", nodesep="0.5", ranksep="0.65", fontname="Noto Sans CJK SC", dpi=150];
node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#4771a3", penwidth=1.4, fontname="Noto Sans CJK SC", fontsize=17, margin="0.18,0.12"];
edge [color="#53677f", fontname="Noto Sans CJK SC", fontsize=13, arrowsize=0.8];
Y [label="ConfigLoader / Validator\n有效配置与 hash", fillcolor="#edf4ff", shape=box];
R [label="HealthRegistry\n注册并组合模块", fillcolor="#edf4ff", shape=box];
I [label="ROS 消息 / 其他节点输出", fillcolor="#eff1f4", shape=box];
A [label="IInputAdapter\n类型、单位、坐标、字段语义", fillcolor="#edf4ff", shape=box];
C [label="IHealthChecker\n雷达 / IMU / 定位 / 感知 / 规划", fillcolor="#edf4ff", shape=box];
S [label="共有 C++ 组件\nStream / Kinematics / Covariance / Clock", fillcolor="#edf4ff", shape=box];
T [label="独立 RuntimeController", fillcolor="#edf4ff", shape=box];
L [label="LifecycleTracker\n意图、确认、实例、epoch", fillcolor="#edf4ff", shape=box];
W [label="RuleLatch / RecoveryGate\n周期异常保留与恢复", fillcolor="#edf4ff", shape=box];
G [label="DependencyAggregator\n等级 + 业务有效性", fillcolor="#edf4ff", shape=box];
O [label="DiagnosticPublisher\n通用面板 / 接收超时", fillcolor="#e5f6ee", shape=box];
E [label="EventRecorder / MetricsRecorder\n可追溯日志", fillcolor="#e5f6ee", shape=box];
Y -> R;
R -> A [label="配置"];
R -> C [label="实例化"];
I -> A;
A -> C [label="统一样本"];
S -> C [label="组合"];
T -> L;
L -> C [label="状态上下文"];
C -> W [label="规则结果"];
W -> G;
G -> O;
W -> E;
L -> E;
Y -> E [label="配置快照"];
}
