digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.6", fontname="Noto Sans CJK SC", dpi=150];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#94A3B8", penwidth=1.4, fontname="Noto Sans CJK SC", fontsize=16, margin="0.18,0.12"];
  edge [color="#64748B", fontname="Noto Sans CJK SC", fontsize=12, arrowsize=0.8];
  input [label="数据输入\n雷达 · IMU · 定位", fillcolor="#E0F2FE", color="#0284C7"];
  adapter [label="C++ 输入适配\n解析消息 · 统一单位"];
  core [label="C++ 健康检查\n按规则检查每个模块", fillcolor="#EDE9FE", color="#7C3AED"];
  aggregate [label="状态汇总\n模块等级 · 定位可用性"];
  output [label="结果输出\nRViz · ROS 诊断 · JSONL/CSV", fillcolor="#DCFCE7", color="#16A34A"];
  config [label="YAML 配置\n话题 · 单位 · 阈值", fillcolor="#FEF3C7", color="#D97706"];
  runtime [label="运行控制\n启动 · 停止 · 重启", fillcolor="#F1F5F9"];
  input -> adapter -> core -> aggregate -> output;
  config -> core [label="规则"];
  runtime -> core [label="运行状态"];
}
