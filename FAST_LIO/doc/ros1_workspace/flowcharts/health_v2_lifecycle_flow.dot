digraph G {
  graph [rankdir=LR, bgcolor="white", pad="0.3", nodesep="0.45", ranksep="0.55", fontname="Noto Sans CJK SC", dpi=150];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#94A3B8", penwidth=1.3, fontname="Noto Sans CJK SC", fontsize=15, margin="0.17,0.11"];
  edge [color="#64748B", fontname="Noto Sans CJK SC", fontsize=11, arrowsize=0.8];
  U [label="未知\n未收到运行状态", fillcolor="#FEF3C7", color="#D97706"];
  S [label="启动中\n建立新数据基线", fillcolor="#E0F2FE", color="#0284C7"];
  R [label="运行中\n持续检查数据", fillcolor="#DCFCE7", color="#16A34A"];
  T [label="正常停止\n灰色待机，定位不可用", fillcolor="#F1F5F9"];
  F [label="异常\n意外退出或超时", fillcolor="#FEE2E2", color="#DC2626"];
  U -> S [label="收到 RUN"];
  S -> R [label="数据就绪"];
  S -> F [label="启动失败 / 超时"];
  R -> T [label="收到 STOP 且确认退出"];
  R -> F [label="意外断流 / 进程退出"];
  T -> S [label="再次 RUN\n清除旧基线"];
  F -> S [label="重新启动"];
}
