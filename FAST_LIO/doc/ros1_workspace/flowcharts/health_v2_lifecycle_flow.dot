digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.5", ranksep="0.65", fontname="Noto Sans CJK SC", dpi=150];
node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#4771a3", penwidth=1.4, fontname="Noto Sans CJK SC", fontsize=17, margin="0.18,0.12"];
edge [color="#53677f", fontname="Noto Sans CJK SC", fontsize=13, arrowsize=0.8];
U [label="UNKNOWN\n意图未确认 / 不假定正常停机", fillcolor="#fff4d9", shape=box];
S [label="STARTING\n新实例/epoch、清基线、有界宽限", fillcolor="#eff1f4", shape=box];
R [label="RUNNING\n按规则独立输出 OK / WARNING / ERROR", fillcolor="#e5f6ee", shape=box];
P [label="STOPPING\n明确 STOP 请求 / 等确认", fillcolor="#fff4d9", shape=box];
T [label="STOPPED\n正常停止灰显 / operational_valid=false", fillcolor="#eff1f4", shape=box];
F [label="FAULT\n非计划缺流 / 进程丢失 / 控制超时", fillcolor="#fde9e9", shape=box];
A [label="PAUSED\n明确回放暂停 / 不提供实时有效性", fillcolor="#eff1f4", shape=box];
U -> S [label="新鲜 RUN / 新实例"];
S -> R [label="ready、样本和窗口完成"];
S -> F [label="初始化超时/启动失败"];
R -> P [label="STOP 意图先于进程停止"];
P -> T [label="确认目标已停止"];
P -> F [label="停机确认超时"];
T -> T [label="管理心跳有效：可等待30秒或更长"];
T -> S [label="后续 RUN / 新实例"];
R -> F [label="非计划断流/进程丢失"];
F -> S [label="新实例启动"];
F -> R [label="同实例输出恢复且持续通过"];
R -> A [label="明确暂停"];
A -> S [label="恢复并重建窗口"];
T -> U [label="管理端失联"];
R -> U [label="管理端失联"];
}
