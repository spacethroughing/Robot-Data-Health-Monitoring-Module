digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.5", ranksep="0.65", fontname="Noto Sans CJK SC", dpi=150];
node [shape=box, style="rounded,filled", fillcolor="#edf4ff", color="#4771a3", penwidth=1.4, fontname="Noto Sans CJK SC", fontsize=17, margin="0.18,0.12"];
edge [color="#53677f", fontname="Noto Sans CJK SC", fontsize=13, arrowsize=0.8];
A [label="雷达消息 + 接收单调时间", fillcolor="#edf4ff", shape=box];
B [label="结构 / 字段 / 尺寸\n能否安全解码？", fillcolor="#fff4d9", shape=diamond];
C [label="统计总点数与有效点数\n检查同代际时间戳", fillcolor="#edf4ff", shape=box];
D [label="空扫描 / 无有效点\n或硬错误？", fillcolor="#fff4d9", shape=diamond];
E [label="立即 ERROR\n拒绝坏消息 / 留事件", fillcolor="#fde9e9", shape=box];
F [label="按 YAML 比较数量、有效率\n频率上下界、接收年龄、时间戳", fillcolor="#edf4ff", shape=box];
G [label="软告警持续时间 / 恢复滞回\n保留周期最严重事件", fillcolor="#edf4ff", shape=box];
H [label="诊断 + 可追溯日志\n状态和检查覆盖率", fillcolor="#e5f6ee", shape=box];
A -> B;
B -> E [label="否"];
B -> C [label="是"];
C -> D;
D -> E [label="是"];
D -> F [label="否"];
F -> G;
G -> H;
E -> H;
}
