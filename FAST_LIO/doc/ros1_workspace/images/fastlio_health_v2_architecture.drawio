<mxfile host="app.diagrams.net" modified="2026-10-12T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="v2-project" name="V2项目技术架构"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="1264" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram_title" value="FAST-LIO 定位健康监控 V2｜项目技术架构&lt;br&gt;ROS Noetic · C++ 核心/适配器 · 生命周期管理 · 可追溯诊断" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="2" width="1290.0" height="58" as="geometry" /></mxCell><mxCell id="e0" value="bag 文件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vbag" target="vplayer"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="原始 LiDAR / IMU 旁路" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vbag" target="vadapters"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="LiDAR / IMU" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vdevice" target="vfastlio"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="原始 LiDAR / IMU 旁路" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vdevice" target="vadapters"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="启动配置" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vlaunch" target="vcontroller"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="管理传感器回放" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vcontroller" target="vplayer"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e6" value="监督定位进程" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vcontroller" target="vfastlio"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e7" value="RuntimeState 心跳" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vcontroller" target="vlifecycle"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e8" value="/clock + 数据回放" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vplayer" target="vfastlio"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e9" value="/Odometry + 输入旁路订阅" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vfastlio" target="vadapters"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e10" value="点云 / 地图 / TF / Path" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vfastlio" target="vrviz"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e11" value="有效配置" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vconfig" target="vregistry"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e12" value="配置快照/hash" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vconfig" target="vrecorder"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e13" value="实例化/订阅" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vregistry" target="vadapters"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e14" value="统一样本" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vadapters" target="vcore"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e15" value="规则结果" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vcore" target="vaggregate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e16" value="指标样本" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vcore" target="vrecorder"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e17" value="运行状态/意图" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vlifecycle" target="vaggregate"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e18" value="5 Hz" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vaggregate" target="vdiagnostics"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e19" value="候选/触发/恢复事件" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vaggregate" target="vrecorder"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e20" value="订阅诊断" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vdiagnostics" target="vrviz"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e21" value="健康状态" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vdiagnostics" target="vrviz"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e22" value="异步写入/轮转" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vrecorder" target="vfiles"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e24" value="控制请求/状态" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vrosapi" target="vcontroller"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vbag" value="&lt;b&gt;rosbag 数据&lt;/b&gt;&lt;br&gt;Livox CustomMsg + sensor_msgs/Imu" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="1068.5" y="152.0" width="235.0" height="44.0" as="geometry" /></mxCell><mxCell id="vdevice" value="&lt;b&gt;真实传感器&lt;/b&gt;&lt;br&gt;Livox 驱动 / 其他 ROS 数据源" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E0F2FE;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="861.5" y="152.0" width="183.0" height="44.0" as="geometry" /></mxCell><mxCell id="vlaunch" value="&lt;b&gt;managed_bag_testbench.launch&lt;/b&gt;&lt;br&gt;组合配置、仿真时钟、TF、RViz" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="581.5" y="301.0" width="213.0" height="44.0" as="geometry" /></mxCell><mxCell id="vcontroller" value="&lt;b&gt;RuntimeController&lt;/b&gt;&lt;br&gt;按配置启动/停止子进程&lt;br&gt;RUN · STOP · RESET_FRAME" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="858.5" y="294.5" width="199.0" height="57.0" as="geometry" /></mxCell><mxCell id="vplayer" value="&lt;b&gt;BagPlaybackCoordinator&lt;/b&gt;&lt;br&gt;先暂停 rosbag&lt;br&gt;确认 FAST-LIO 与监控 TCPROS 连接后起播" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DBEAFE;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="302.5" y="294.5" width="255.0" height="57.0" as="geometry" /></mxCell><mxCell id="vfastlio" value="&lt;b&gt;FAST-LIO / laserMapping&lt;/b&gt;&lt;br&gt;LiDAR + IMU → Odometry / TF&lt;br&gt;注册点云 / 累积地图 / Path" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D1FAE5;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="298.5" y="443.5" width="195.0" height="57.0" as="geometry" /></mxCell><mxCell id="vconfig" value="&lt;b&gt;YAML ConfigLoader / Validator&lt;/b&gt;&lt;br&gt;严格校验规则、单位、依赖&lt;br&gt;保存原始/有效配置与 hash" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="517.0" y="443.5" width="196.0" height="57.0" as="geometry" /></mxCell><mxCell id="vregistry" value="&lt;b&gt;HealthRegistry&lt;/b&gt;&lt;br&gt;按 module_id 组装模块&lt;br&gt;定位 / 感知 / 规划均可扩展" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="776.0" y="443.5" width="168.0" height="57.0" as="geometry" /></mxCell><mxCell id="vadapters" value="&lt;b&gt;C++ InputAdapters&lt;/b&gt;&lt;br&gt;Livox / PointCloud2 / IMU&lt;br&gt;Odometry / Pose / 规划任务&lt;br&gt;校验字段并统一单位、坐标语义" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="749.5" y="595.5" width="195.0" height="70.0" as="geometry" /></mxCell><mxCell id="vcore" value="&lt;b&gt;robot_health_core&lt;/b&gt;&lt;br&gt;Checker + Stream / Kinematics / Covariance&lt;br&gt;频率、时间戳、点数、IMU、定位运动/协方差" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#DDD6FE;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="667.0" y="714.5" width="270.0" height="57.0" as="geometry" /></mxCell><mxCell id="vlifecycle" value="&lt;b&gt;LifecycleTracker&lt;/b&gt;&lt;br&gt;控制意图 + 管理心跳&lt;br&gt;instance_id / command_id / frame_epoch" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="600.0" y="519.5" width="262.0" height="57.0" as="geometry" /></mxCell><mxCell id="vaggregate" value="&lt;b&gt;RuleLatch + DependencyAggregator&lt;/b&gt;&lt;br&gt;异常持续/恢复门限&lt;br&gt;模块等级、总体等级、业务有效性" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EDE9FE;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="524.5" y="820.5" width="229.0" height="57.0" as="geometry" /></mxCell><mxCell id="vdiagnostics" value="&lt;b&gt;ROS 输出&lt;/b&gt;&lt;br&gt;DiagnosticArray：overall + modules&lt;br&gt;UInt8：0 OK / 1 WARNING / 2 ERROR" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="728.5" y="976.0" width="231.0" height="57.0" as="geometry" /></mxCell><mxCell id="vrviz" value="&lt;b&gt;RViz C++ Health Panel + 3D&lt;/b&gt;&lt;br&gt;健康等级/指标/失联超时&lt;br&gt;原始点云、注册点云、地图、Path、TF" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="728.0" y="1088.5" width="234.0" height="57.0" as="geometry" /></mxCell><mxCell id="vrecorder" value="&lt;b&gt;EventRecorder / MetricsRecorder&lt;/b&gt;&lt;br&gt;JSONL 事件 + CSV 周期指标&lt;br&gt;配置/源码/二进制/数据引用 hash&lt;br&gt;日志失败与丢失状态可见" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE7F3;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="486.0" y="969.5" width="210.0" height="70.0" as="geometry" /></mxCell><mxCell id="vfiles" value="&lt;b&gt;运行归档目录&lt;/b&gt;&lt;br&gt;manifest.json · effective_config.yaml&lt;br&gt;events.*.jsonl · metrics.*.csv" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="464.0" y="1088.5" width="240.0" height="57.0" as="geometry" /></mxCell><mxCell id="vrosapi" value="&lt;b&gt;ROS 接口&lt;/b&gt;&lt;br&gt;/robot_runtime/control 服务&lt;br&gt;/robot_runtime/module_state 心跳" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FEF3C7;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30.0" y="145.5" width="224.0" height="57.0" as="geometry" /></mxCell><mxCell id="vnote" value="&lt;b&gt;边界：判定核心使用统一 C++ 数据结构，不直接依赖 ROS 消息；ROS 适配器负责解析与转换。当前部署包、节点、Topic、launch 和 RViz 仍运行于 ROS1。&lt;/b&gt;&lt;br&gt;STOPPED/PAUSED 只有收到有效管理意图才视为计划停用；非计划退出或管理心跳丢失会报错。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFBEB;strokeColor=#F59E0B;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="232.5" y="1184.5" width="703.0" height="40.0" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>