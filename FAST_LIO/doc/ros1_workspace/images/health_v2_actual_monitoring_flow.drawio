<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" agent="Codex" version="24.7.17" type="device"><diagram id="health-v2-monitoring" name="健康检测V2监测逻辑与具体指标"><mxGraphModel dx="1700" dy="2700" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="0" pageScale="1" pageWidth="1700" pageHeight="2700" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="config" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-family:Noto Sans CJK SC,Microsoft YaHei,sans-serif;font-size:16px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#e8f0fe;text-align:center;padding:10px;font-size:19px;&quot;&gt;&lt;b&gt;① 启动：读取 YAML 配置&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;校验字段、单位、阈值顺序、模块依赖；配置不合法则启动失败&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;普通入口：health_v2_avia.yaml；管理式入口：health_v2_managed.yaml&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;阈值修改后需重启；注释参数不等于关闭检测，缺项可能采用默认值&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="292.0" y="153.0" width="559.0" height="157.0" /></mxCell><mxCell id="adapter" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-family:Noto Sans CJK SC,Microsoft YaHei,sans-serif;font-size:16px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#e8f0fe;text-align:center;padding:10px;font-size:19px;&quot;&gt;&lt;b&gt;② C++ 适配器：接入原始输入与定位输出&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;雷达 /livox/lidar → LivoxCustomAdapter → LidarChecker&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;IMU /livox/imu → RosImuAdapter → ImuChecker&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;定位 /Odometry → OdometryAdapter → LocalizationChecker&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;输入类型、结构、坐标系与数值校验；加速度 g × 9.80665 转 m/s²&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="326.0" y="341.0" width="491.0" height="195.0" /></mxCell><mxCell id="life" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-family:Noto Sans CJK SC,Microsoft YaHei,sans-serif;font-size:16px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#e8f0fe;text-align:center;padding:10px;font-size:19px;&quot;&gt;&lt;b&gt;③ 先判断生命周期：现在是否应该有数据？&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;控制器持续发送意图和进程状态；已接入后心跳 &amp;gt;1 s 警告，&amp;gt;3 s UNKNOWN / ERROR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;管理式配置 strict_intent=true：没有控制意图时不能猜测正常停止&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;确认 STOPPED / PAUSED 时暂停持续数据要求；收到的严重坏数据仍会报错&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="262.0" y="567.0" width="619.0" height="157.0" /></mxCell><mxCell id="stop" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-family:Noto Sans CJK SC,Microsoft YaHei,sans-serif;font-size:16px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#f1f5f9;text-align:center;padding:10px;font-size:19px;&quot;&gt;&lt;b&gt;计划停止：STOP → STOPPING → STOPPED&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;控制器确认进程退出；默认 5 s 内未确认则停止失败&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;定位灰色停用、业务有效=false；旧 UInt8 状态为 WARNING&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;定位停用时雷达、IMU继续独立监控；监控与控制器保持运行&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="60.0" y="769.0" width="445.0" height="157.0" /></mxCell><mxCell id="start" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-family:Noto Sans CJK SC,Microsoft YaHei,sans-serif;font-size:16px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#ede9fe;text-align:center;padding:10px;font-size:19px;&quot;&gt;&lt;b&gt;启动 / 重启：RUN → STARTING → RUNNING&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;新实例 / 控制器 / 坐标系代际：清空该模块旧历史&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;连续10个无ERROR样本 + 频率覆盖达标 + 进程运行才就绪&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;启动期限10 s；超时ERROR；启动期间严重坏数据立即ERROR&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="632.5" y="769.0" width="458.0" height="157.0" /></mxCell><mxCell id="time" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-family:Noto Sans CJK SC,Microsoft YaHei,sans-serif;font-size:16px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#e8f0fe;text-align:center;padding:10px;font-size:19px;&quot;&gt;&lt;b&gt;④ 共用时间与频率检查（RUNNING 的持续数据要求）&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;header.stamp：必须 &amp;gt;0；重复 → WARNING；同代际倒退 → 立即 ERROR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;源时间间隔 Δt：雷达/定位 &amp;gt;0.3 s / &amp;gt;1.0 s；IMU &amp;gt;0.02 s / &amp;gt;0.1 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;接收年龄：单调时钟计算“多久没收到消息”，按模块阈值判断&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;频率默认用源时间戳：5 s 窗口、至少3条、覆盖至少1 s；不足显示 N/A&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;绝对传输延迟：N/A，尚无可靠设备—主机时钟对应关系&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="589.5" y="971.0" width="544.0" height="233.0" /></mxCell><mxCell id="lidar" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-family:Noto Sans CJK SC,Microsoft YaHei,sans-serif;font-size:16px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#dbeafe;text-align:center;padding:10px;font-size:19px;&quot;&gt;&lt;b&gt;⑤-A 雷达：数量 / 频率 / 时间 / 点云质量&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;总点数、有效点数：WARNING &amp;lt;100 点；ERROR &amp;lt;1 点&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;空扫描或没有有效点：立即 ERROR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;有效点比例：WARNING &amp;lt;0.8；ERROR &amp;lt;0.5&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;有效点：坐标有限，距离 &amp;gt;0.0001 m 且 ≤500 m&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;源频率：WARNING &amp;lt;8 或 &amp;gt;12 Hz；ERROR &amp;lt;5 或 &amp;gt;20 Hz&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;接收年龄：WARNING &amp;gt;0.5 s；ERROR &amp;gt;1.5 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;结构损坏立即 ERROR；点云数量与有效比例分别判断&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="174.5" y="1349.0" width="418.0" height="309.0" /></mxCell><mxCell id="imu" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-family:Noto Sans CJK SC,Microsoft YaHei,sans-serif;font-size:16px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#ccfbf1;text-align:center;padding:10px;font-size:19px;&quot;&gt;&lt;b&gt;⑤-B IMU：加速度计 / 陀螺仪 / 时间 / 数据质量&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;加速度向量模长（含重力）：WARNING &amp;gt;100；ERROR &amp;gt;200 m/s²&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;角速度向量模长：WARNING &amp;gt;35；ERROR &amp;gt;70 rad/s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;源频率：WARNING &amp;lt;160 或 &amp;gt;260 Hz；ERROR &amp;lt;50 或 &amp;gt;400 Hz&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;接收年龄：WARNING &amp;gt;0.15 s；ERROR &amp;gt;0.6 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;加速度、角速度必需；当前 Avia 不要求姿态估计&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;有限值与测量可用性检查；协方差检查有限/对称/半正定&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;全零协方差表示未知，默认仅报告；不是“噪声为零”&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="617.5" y="1349.0" width="488.0" height="309.0" /></mxCell><mxCell id="loc" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-family:Noto Sans CJK SC,Microsoft YaHei,sans-serif;font-size:16px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#fef3c7;text-align:center;padding:10px;font-size:19px;&quot;&gt;&lt;b&gt;⑤-C 定位：时间 / 频率 / 运动 / 协方差 / 跳变&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;源频率：WARNING &amp;lt;5 或 &amp;gt;15 Hz；ERROR &amp;lt;1 或 &amp;gt;30 Hz&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;接收年龄：WARNING &amp;gt;0.3 s；ERROR &amp;gt;1.0 s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;速度：WARNING &amp;gt;15；ERROR &amp;gt;50 m/s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;向量加速度：WARNING &amp;gt;10；ERROR &amp;gt;30 m/s²&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;角速度：WARNING &amp;gt;3；ERROR &amp;gt;10 rad/s&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;位置预测残差：WARNING &amp;gt;0.5；ERROR &amp;gt;2 m&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;相邻姿态短弧角差：WARNING &amp;gt;0.3；ERROR &amp;gt;1 rad&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;位置方差 xyz 对角最大值：WARNING &amp;gt;1；ERROR &amp;gt;4 m²&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;姿态方差三对角最大值：WARNING &amp;gt;0.1；ERROR &amp;gt;0.5 rad²&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;全零协方差 → 未知WARNING；另查有限/对称/半正定&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;四元数 |norm(q)-1|：WARNING &amp;gt;0.02；ERROR &amp;gt;0.1&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;坐标系 camera_init / body；位姿、四元数有限且有效&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;差分 dt 限0.001～1 s；至少2帧算速度、3帧算加速度&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="1131.0" y="1235.0" width="443.0" height="537.0" /></mxCell><mxCell id="latch" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-family:Noto Sans CJK SC,Microsoft YaHei,sans-serif;font-size:16px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#e8f0fe;text-align:center;padding:10px;font-size:19px;&quot;&gt;&lt;b&gt;⑥ 每条规则处理触发、保持与恢复&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;优先级 ERROR &amp;gt; WARNING &amp;gt; OK；超过上限/低于下限才触发，等于阈值不触发&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;软异常持续0.5 s触发；有效通过证据持续1 s恢复&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;NaN、结构错误、空点云、时间倒退、严重运动ERROR等硬异常立即触发&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;未具备计算条件显示 N/A；新数据代际重新建立时间与运动基线&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="573.5" y="1803.0" width="576.0" height="195.0" /></mxCell><mxCell id="summary" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-family:Noto Sans CJK SC,Microsoft YaHei,sans-serif;font-size:16px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#e8f0fe;text-align:center;padding:10px;font-size:19px;&quot;&gt;&lt;b&gt;⑦ 模块健康与总体业务有效性汇总&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;分别输出雷达、IMU、定位的等级、原因、生命周期与指标&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;总体健康等级取 required 模块最严重等级；定位业务依赖雷达与IMU&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;按计划停用 / 启动中：业务有效=false；兼容状态WARNING，硬错误优先ERROR&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;异常退出 / 应运行却断流：FAULT / ERROR；日志故障也参与总体判断&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="569.5" y="2029.0" width="584.0" height="195.0" /></mxCell><mxCell id="display" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-family:Noto Sans CJK SC,Microsoft YaHei,sans-serif;font-size:16px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#dcfce7;text-align:center;padding:10px;font-size:19px;&quot;&gt;&lt;b&gt;⑧ 实时显示与接口&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;5 Hz DiagnosticArray → RViz健康面板；UInt8：0/1/2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;显示频率、接收年龄、点数、IMU、定位运动/方差、代际、异常原因&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;RViz另外显示原始点云、当前帧、地图；诊断失联2 s后旧状态失效&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="344.5" y="2255.0" width="498.0" height="157.0" /></mxCell><mxCell id="logs" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-family:Noto Sans CJK SC,Microsoft YaHei,sans-serif;font-size:16px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#fce7f3;text-align:center;padding:10px;font-size:19px;&quot;&gt;&lt;b&gt;⑧ 可追溯日志（贯穿启停与规则判断）&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;事件 JSONL：候选 / 触发 / 恢复 / 启停；指标 CSV：默认1 s采样&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;记录实例ID、数据代际、运行ID、有效配置、版本及数据/二进制哈希&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;写入失败、丢记录、删除旧日志可见；日志不完整=false 表示未发现缺失&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="868.0" y="2255.0" width="527.0" height="157.0" /></mxCell><mxCell id="note" value="&lt;table style=&quot;border-collapse:collapse;width:100%;font-family:Noto Sans CJK SC,Microsoft YaHei,sans-serif;font-size:16px;&quot;&gt;&lt;tr&gt;&lt;td style=&quot;background:#e8f0fe;text-align:center;padding:10px;font-size:19px;&quot;&gt;&lt;b&gt;适用范围与阅读说明&lt;/b&gt;&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;图中阈值是本项目开发/回放默认值，实机部署须按设备、平台与采样率标定&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;源时间戳间隔 ≠ 接收年龄 ≠ 绝对传输延迟；频率默认不随2倍bag播放翻倍&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style=&quot;padding:10px;white-space:nowrap;&quot;&gt;噪声、卡死、饱和的专用标定规则尚未实现；当前异常幅值阈值不是硬件量程&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#CBD5E1;align=left;verticalAlign=top;spacing=0;overflow=fill;fontSize=16;" vertex="1" parent="1"><mxGeometry as="geometry" x="582.5" y="2443.0" width="558.0" height="157.0" /></mxCell><mxCell id="edge-0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="config" target="adapter"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="adapter" target="life"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-2" value="计划停止" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="life" target="stop"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-3" value="需要运行" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="life" target="start"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-4" value="等待后再次 RUN" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="stop" target="start"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-5" value="就绪后持续检查" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="start" target="time"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-6" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="time" target="lidar"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-7" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#64748B;fontSize=14;fontFamily=Microsoft YaHei;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="time" target="imu"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="edge-8" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFi