<mxfile host="app.diagrams.net" modified="2026-10-14T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="health-v2-main" name="健康监控工作流程"><mxGraphModel dx="1600" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1000" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="config" value="启动监控&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;读取 YAML 配置&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=18;fontFamily=Microsoft YaHei;fillColor=#FEF3C7;strokeColor=#D97706;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="50" width="360" height="84" as="geometry" /></mxCell><mxCell id="input" value="接收数据&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;雷达 · IMU · 定位&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=18;fontFamily=Microsoft YaHei;fillColor=#E0F2FE;strokeColor=#0284C7;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="170" width="360" height="84" as="geometry" /></mxCell><mxCell id="adapter" value="整理数据&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;统一消息格式、单位和坐标&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=18;fontFamily=Microsoft YaHei;fillColor=#F8FAFC;strokeColor=#94A3B8;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="620" y="290" width="360" height="84" as="geometry" /></mxCell><mxCell id="lidar" value="雷达检查&lt;br&gt;&lt;font style=&quot;font-size:13px&quot;&gt;点数 · 有效率 · 频率 · 时间&lt;/font&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;spacing=10;fontSize=18;fontFamily=Microsoft YaHei;fillColor=#DBEAFE;strokeColor=#2563EB;strokeWidth=2;" vertex="1" parent="1"><mxGeometry x="45" y="460" width="330" height="112" as="geometry" /></mxCell><mxCell id="imu" value="IMU 检查&lt;br