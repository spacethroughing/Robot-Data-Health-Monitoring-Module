<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" modified="2026-10-12T00:00:00.000Z" agent="Codex" version="24.7.17" type="device"><diagram id="v2-project" name="V2项目使用说明"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1058" pageHeight="1413" math="0" shadow="0"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="diagram_title" value="FAST-LIO 定位健康监控 V2｜使用说明&lt;br&gt;推荐：管理式 rosbag 联调、实时健康观察、正常停止与重启、日志追溯" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=22;fontColor=#0F172A;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="30" y="2" width="998.0" height="58" as="geometry" /></mxCell><mxCell id="e0" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vprepare" target="vstart"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vstart" target="vobserve"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vobserve" target="vstop"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e3" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vstop" target="vrestart"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e4" value="持续检查新实例" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;dashed=1;" edge="1" parent="1" source="vrestart" target="vobserve"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="e5" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#64748B;strokeWidth=1.4;endArrow=block;endFill=1;fontSize=12;fontColor=#475569;" edge="1" parent="1" source="vrestart" target="vlogs"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="vprepare" value="&lt;b&gt;① 首次使用或源码更新后：加载环境并编译&lt;/b&gt;&lt;br&gt;bash&lt;br&gt;source /opt/ros/noetic/setup.bash&lt;br&gt;cd /home/lmw/fastlio_ws &amp;amp;&amp;amp; catkin_make -j2&lt;br&gt;source /home/lmw/fastlio_ws/devel/setup.bash&lt;br&gt;每个新终端都要 source；仅运行已编译版本时可跳过编译。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="383.5" y="90.0" width="372.0" height="235.0" as="geometry" /></mxCell><mxCell id="vstart" value="&lt;b&gt;② 启动完整 V2 管理式回放&lt;/b&gt;&lt;br&gt;roslaunch fastlio_health_monitor managed_bag_testbench.launch&lt;br&gt;自动启动监控器、运行控制器、FAST-LIO、bag、静态 TF 和 RViz；默认传感器/监控配置为 health_v2_managed.yaml，进程组配置为 runtime_bag.yaml。&lt;br&gt;启动失败先看终端 YAML 校验、bag 文件路径、ROS master 与 topic 配置。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="139.0" y="350.0" width="861.0" height="158.0" as="geometry" /></mxCell><mxCell id="vobserve" value="&lt;b&gt;③ 同时观察健康状态、定位输出和运行状态&lt;/b&gt;&lt;br&gt;RViz：健康面板查看 overall / LiDAR / IMU / localization；3D 查看原始点云、注册点云、地图、Path 与 TF。&lt;br&gt;rostopic echo /fastlio_health_monitor/diagnostics&lt;br&gt;rostopic echo /robot_runtime/module_state&lt;br&gt;总体等级：OK / WARNING / ERROR；定位还需关注 observed_state、instance_id、业务有效性和原因。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="265.5" y="533.0" width="608.0" height="194.0" as="geometry" /></mxCell><mxCell id="vstop" value="&lt;b&gt;④ 正常关闭定位：发出 STOP，并等待停止确认&lt;/b&gt;&lt;br&gt;rosservice call /robot_runtime/control &amp;quot;{binding: &amp;#x27;localization&amp;#x27;, command: &amp;#x27;STOP&amp;#x27;}&amp;quot;&lt;br&gt;服务 accepted 只表示请求收到；继续观察 module_state，直到 observed_state=STOPPED。传感器回放和监控仍在运行。&lt;br&gt;STOPPED 时定位数据不可用、业务有效=false；等待 30 秒不会因计划停机误报定位断流。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="30.0" y="752.0" width="687.0" height="158.0" as="geometry" /></mxCell><mxCell id="vrestart" value="&lt;b&gt;⑤ 正常重新启动定位：RUN 并等待新实例就绪&lt;/b&gt;&lt;br&gt;rosservice call /robot_runtime/control &amp;quot;{binding: &amp;#x27;localization&amp;#x27;, command: &amp;#x27;RUN&amp;#x27;}&amp;quot;&lt;br&gt;观察 STARTING → RUNNING；确认 producer_instance_id 更新，监控用新数据建立时间与运动基线。&lt;br&gt;若要从头重播整份 bag，需按顺序 STOP 定位和 sensors，再 RUN localization 与 sensors；不要让旧定位状态接续新一轮 bag。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="215.5" y="935.0" width="708.0" height="158.0" as="geometry" /></mxCell><mxCell id="vlogs" value="&lt;b&gt;⑥ 查可追溯日志、复现故障 bag，最后正常退出&lt;/b&gt;&lt;br&gt;监控日志：/home/lmw/fastlio_ws/logs/robot_health/&amp;lt;run_id&amp;gt;/；控制日志：/home/lmw/fastlio_ws/logs/robot_runtime/&amp;lt;run_id&amp;gt;/。&lt;br&gt;核对 manifest、effective_config、events JSONL、metrics CSV；用 instance_id / command_id / module_epoch 串联启停与异常。&lt;br&gt;python3 /home/lmw/fastlio_ws/src/fastlio_health_monitor/test/run_fault_bag_tests.py&lt;br&gt;回放结束后按 Ctrl+C 关闭整套 launch。原始 bag 保持不变；错误样例为独立副本。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E2E8F0;strokeColor=#94A3B8;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="187.0" y="1118.0" width="765.0" height="194.0" as="geometry" /></mxCell><mxCell id="vdone" value="&lt;b&gt;运行边界&lt;/b&gt;&lt;br&gt;本配置针对当前 Livox Avia bag 和 ROS Noetic。换设备/消息类型时，检查 health_v2_*.yaml、runtime_bag.yaml、bag 路径、Topic 与外参。阈值为开发/回放默认值，实机需标定。" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#FDBA74;fontColor=#0F172A;fontSize=14;align=center;verticalAlign=middle;spacing=8;" vertex="1" parent="1"><mxGeometry x="111.0" y="1337.0" width="917.0" height="36.0" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>