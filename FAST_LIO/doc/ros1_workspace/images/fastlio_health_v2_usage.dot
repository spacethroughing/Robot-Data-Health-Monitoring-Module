digraph V2Usage {
  graph [rankdir=TB, bgcolor="#F8FAFC", pad="0.35", nodesep="0.34", ranksep="0.34", splines=ortho, fontname="Noto Sans CJK SC", label="FAST-LIO 定位健康监控 V2｜使用说明\n推荐：管理式 rosbag 联调、实时健康观察、正常停止与重启、日志追溯", labelloc=t, fontsize=24, fontcolor="#0F172A"];
  node [shape=plain, fontname="Noto Sans CJK SC"];
  edge [color="#64748B", penwidth=1.4, arrowsize=0.8, fontname="Noto Sans CJK SC", fontsize=11, fontcolor="#475569"];

  prepare [label=<<TABLE BORDER="1" COLOR="#93C5FD" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD ALIGN="LEFT" BGCOLOR="#DBEAFE"><FONT POINT-SIZE="18"><B>① 首次使用或源码更新后：加载环境并编译</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13">bash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13">source /opt/ros/noetic/setup.bash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13">cd $HOME/fastlio_ws &amp;&amp; catkin_make -j2</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13">source $HOME/fastlio_ws/devel/setup.bash</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">每个新终端都要 source；仅运行已编译版本时可跳过编译。</FONT></TD></TR></TABLE>>];

  start [label=<<TABLE BORDER="1" COLOR="#86EFAC" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD ALIGN="LEFT" BGCOLOR="#DCFCE7"><FONT POINT-SIZE="18"><B>② 启动完整 V2 管理式回放</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13">roslaunch fastlio_health_monitor managed_bag_testbench.launch</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">自动启动监控器、运行控制器、FAST-LIO、bag、静态 TF 和 RViz；默认传感器/监控配置为 health_v2_managed.yaml，进程组配置为 runtime_bag.yaml。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">启动失败先看终端 YAML 校验、bag 文件路径、ROS master 与 topic 配置。</FONT></TD></TR></TABLE>>];

  observe [label=<<TABLE BORDER="1" COLOR="#C4B5FD" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD ALIGN="LEFT" BGCOLOR="#EDE9FE"><FONT POINT-SIZE="18"><B>③ 同时观察健康状态、定位输出和运行状态</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">RViz：健康面板查看 overall / LiDAR / IMU / localization；3D 查看原始点云、注册点云、地图、Path 与 TF。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12">rostopic echo /fastlio_health_monitor/diagnostics</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12">rostopic echo /robot_runtime/module_state</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">总体等级：OK / WARNING / ERROR；定位还需关注 observed_state、instance_id、业务有效性和原因。</FONT></TD></TR></TABLE>>];

  stop [label=<<TABLE BORDER="1" COLOR="#FDE68A" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD ALIGN="LEFT" BGCOLOR="#FEF3C7"><FONT POINT-SIZE="18"><B>④ 正常关闭定位：发出 STOP，并等待停止确认</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13">rosservice call /robot_runtime/control "{binding: 'localization', command: 'STOP'}"</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">服务 accepted 只表示请求收到；继续观察 module_state，直到 observed_state=STOPPED。传感器回放和监控仍在运行。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">STOPPED 时定位数据不可用、业务有效=false；等待 30 秒不会因计划停机误报定位断流。</FONT></TD></TR></TABLE>>];

  restart [label=<<TABLE BORDER="1" COLOR="#A7F3D0" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD ALIGN="LEFT" BGCOLOR="#D1FAE5"><FONT POINT-SIZE="18"><B>⑤ 正常重新启动定位：RUN 并等待新实例就绪</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="13">rosservice call /robot_runtime/control "{binding: 'localization', command: 'RUN'}"</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">观察 STARTING → RUNNING；确认 producer_instance_id 更新，监控用新数据建立时间与运动基线。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">若要从头重播整份 bag，需按顺序 STOP 定位和 sensors，再 RUN localization 与 sensors；不要让旧定位状态接续新一轮 bag。</FONT></TD></TR></TABLE>>];

  logs [label=<<TABLE BORDER="1" COLOR="#F9A8D4" CELLBORDER="0" CELLSPACING="0" CELLPADDING="12"><TR><TD ALIGN="LEFT" BGCOLOR="#FCE7F3"><FONT POINT-SIZE="18"><B>⑥ 查可追溯日志、复现故障 bag，最后正常退出</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">监控日志：$HOME/fastlio_ws/logs/robot_health/&lt;run_id&gt;/；控制日志：$HOME/fastlio_ws/logs/robot_runtime/&lt;run_id&gt;/。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">核对 manifest、effective_config、events JSONL、metrics CSV；用 instance_id / command_id / module_epoch 串联启停与异常。</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT FACE="Noto Sans Mono CJK SC" POINT-SIZE="12">python3 $HOME/fastlio_ws/src/fastlio_health_monitor/test/run_fault_bag_tests.py</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="12">回放结束后按 Ctrl+C 关闭整套 launch。原始 bag 保持不变；错误样例为独立副本。</FONT></TD></TR></TABLE>>];

  prepare -> start -> observe -> stop -> restart -> logs;
  restart -> observe [style=dashed, label="持续检查新实例"];
  logs -> done [style=invis];
  done [shape=note, style="filled", fillcolor="#FFF7ED", color="#FDBA74", fontname="Noto Sans CJK SC", fontsize=11, label="运行边界\n本配置针对当前 Livox Avia bag 和 ROS Noetic。换设备/消息类型时，检查 health_v2_*.yaml、runtime_bag.yaml、bag 路径、Topic 与外参。阈值为开发/回放默认值，实机需标定。"];
}
