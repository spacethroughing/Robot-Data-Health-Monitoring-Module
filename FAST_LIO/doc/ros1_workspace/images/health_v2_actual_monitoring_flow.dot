digraph G {
graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.35", ranksep="0.42", dpi=160, fontname="Noto Sans CJK SC", label="机器人健康检测 V2｜监测逻辑与当前默认指标\n依据 2026-10-12 实际代码及 health_v2_avia / managed 配置", labelloc=t, fontsize=26];
node [shape=plain, fontname="Noto Sans CJK SC"];
edge [color="#64748B", arrowsize=0.8, fontname="Noto Sans CJK SC", fontsize=14];
config [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD ALIGN="CENTER" BGCOLOR="#E8F0FE"><FONT POINT-SIZE="19"><B>① 启动：读取 YAML 配置</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">校验字段、单位、阈值顺序、模块依赖；配置不合法则启动失败</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">普通入口：health_v2_avia.yaml；管理式入口：health_v2_managed.yaml</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">阈值修改后需重启；注释参数不等于关闭检测，缺项可能采用默认值</FONT></TD></TR></TABLE>>];
adapter [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD ALIGN="CENTER" BGCOLOR="#E8F0FE"><FONT POINT-SIZE="19"><B>② C++ 适配器：接入原始输入与定位输出</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">雷达 /livox/lidar → LivoxCustomAdapter → LidarChecker</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">IMU /livox/imu → RosImuAdapter → ImuChecker</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">定位 /Odometry → OdometryAdapter → LocalizationChecker</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">输入类型、结构、坐标系与数值校验；加速度 g × 9.80665 转 m/s²</FONT></TD></TR></TABLE>>];
life [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD ALIGN="CENTER" BGCOLOR="#E8F0FE"><FONT POINT-SIZE="19"><B>③ 先判断生命周期：现在是否应该有数据？</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">控制器持续发送意图和进程状态；已接入后心跳 &gt;1 s 警告，&gt;3 s UNKNOWN / ERROR</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">管理式配置 strict_intent=true：没有控制意图时不能猜测正常停止</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">确认 STOPPED / PAUSED 时暂停持续数据要求；收到的严重坏数据仍会报错</FONT></TD></TR></TABLE>>];
stop [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD ALIGN="CENTER" BGCOLOR="#F1F5F9"><FONT POINT-SIZE="19"><B>计划停止：STOP → STOPPING → STOPPED</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">控制器确认进程退出；默认 5 s 内未确认则停止失败</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">定位灰色停用、业务有效=false；旧 UInt8 状态为 WARNING</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">定位停用时雷达、IMU继续独立监控；监控与控制器保持运行</FONT></TD></TR></TABLE>>];
start [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD ALIGN="CENTER" BGCOLOR="#EDE9FE"><FONT POINT-SIZE="19"><B>启动 / 重启：RUN → STARTING → RUNNING</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">新实例 / 控制器 / 坐标系代际：清空该模块旧历史</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">连续10个无ERROR样本 + 频率覆盖达标 + 进程运行才就绪</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">启动期限10 s；超时ERROR；启动期间严重坏数据立即ERROR</FONT></TD></TR></TABLE>>];
time [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD ALIGN="CENTER" BGCOLOR="#E8F0FE"><FONT POINT-SIZE="19"><B>④ 共用时间与频率检查（RUNNING 的持续数据要求）</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">header.stamp：必须 &gt;0；重复 → WARNING；同代际倒退 → 立即 ERROR</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">源时间间隔 Δt：雷达/定位 &gt;0.3 s / &gt;1.0 s；IMU &gt;0.02 s / &gt;0.1 s</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">接收年龄：单调时钟计算“多久没收到消息”，按模块阈值判断</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">频率默认用源时间戳：5 s 窗口、至少3条、覆盖至少1 s；不足显示 N/A</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">绝对传输延迟：N/A，尚无可靠设备—主机时钟对应关系</FONT></TD></TR></TABLE>>];
lidar [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD ALIGN="CENTER" BGCOLOR="#DBEAFE"><FONT POINT-SIZE="19"><B>⑤-A 雷达：数量 / 频率 / 时间 / 点云质量</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">总点数、有效点数：WARNING &lt;100 点；ERROR &lt;1 点</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">空扫描或没有有效点：立即 ERROR</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">有效点比例：WARNING &lt;0.8；ERROR &lt;0.5</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">有效点：坐标有限，距离 &gt;0.0001 m 且 ≤500 m</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">源频率：WARNING &lt;8 或 &gt;12 Hz；ERROR &lt;5 或 &gt;20 Hz</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">接收年龄：WARNING &gt;0.5 s；ERROR &gt;1.5 s</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">结构损坏立即 ERROR；点云数量与有效比例分别判断</FONT></TD></TR></TABLE>>];
imu [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD ALIGN="CENTER" BGCOLOR="#CCFBF1"><FONT POINT-SIZE="19"><B>⑤-B IMU：加速度计 / 陀螺仪 / 时间 / 数据质量</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">加速度向量模长（含重力）：WARNING &gt;100；ERROR &gt;200 m/s²</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">角速度向量模长：WARNING &gt;35；ERROR &gt;70 rad/s</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">源频率：WARNING &lt;160 或 &gt;260 Hz；ERROR &lt;50 或 &gt;400 Hz</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">接收年龄：WARNING &gt;0.15 s；ERROR &gt;0.6 s</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">加速度、角速度必需；当前 Avia 不要求姿态估计</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">有限值与测量可用性检查；协方差检查有限/对称/半正定</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">全零协方差表示未知，默认仅报告；不是“噪声为零”</FONT></TD></TR></TABLE>>];
loc [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD ALIGN="CENTER" BGCOLOR="#FEF3C7"><FONT POINT-SIZE="19"><B>⑤-C 定位：时间 / 频率 / 运动 / 协方差 / 跳变</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">源频率：WARNING &lt;5 或 &gt;15 Hz；ERROR &lt;1 或 &gt;30 Hz</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">接收年龄：WARNING &gt;0.3 s；ERROR &gt;1.0 s</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">速度：WARNING &gt;15；ERROR &gt;50 m/s</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">向量加速度：WARNING &gt;10；ERROR &gt;30 m/s²</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">角速度：WARNING &gt;3；ERROR &gt;10 rad/s</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">位置预测残差：WARNING &gt;0.5；ERROR &gt;2 m</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">相邻姿态短弧角差：WARNING &gt;0.3；ERROR &gt;1 rad</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">位置方差 xyz 对角最大值：WARNING &gt;1；ERROR &gt;4 m²</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">姿态方差三对角最大值：WARNING &gt;0.1；ERROR &gt;0.5 rad²</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">全零协方差 → 未知WARNING；另查有限/对称/半正定</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">四元数 |norm(q)-1|：WARNING &gt;0.02；ERROR &gt;0.1</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">坐标系 camera_init / body；位姿、四元数有限且有效</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">差分 dt 限0.001～1 s；至少2帧算速度、3帧算加速度</FONT></TD></TR></TABLE>>];
latch [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD ALIGN="CENTER" BGCOLOR="#E8F0FE"><FONT POINT-SIZE="19"><B>⑥ 每条规则处理触发、保持与恢复</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">优先级 ERROR &gt; WARNING &gt; OK；超过上限/低于下限才触发，等于阈值不触发</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">软异常持续0.5 s触发；有效通过证据持续1 s恢复</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">NaN、结构错误、空点云、时间倒退、严重运动ERROR等硬异常立即触发</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">未具备计算条件显示 N/A；新数据代际重新建立时间与运动基线</FONT></TD></TR></TABLE>>];
summary [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD ALIGN="CENTER" BGCOLOR="#E8F0FE"><FONT POINT-SIZE="19"><B>⑦ 模块健康与总体业务有效性汇总</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">分别输出雷达、IMU、定位的等级、原因、生命周期与指标</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">总体健康等级取 required 模块最严重等级；定位业务依赖雷达与IMU</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">按计划停用 / 启动中：业务有效=false；兼容状态WARNING，硬错误优先ERROR</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">异常退出 / 应运行却断流：FAULT / ERROR；日志故障也参与总体判断</FONT></TD></TR></TABLE>>];
display [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD ALIGN="CENTER" BGCOLOR="#DCFCE7"><FONT POINT-SIZE="19"><B>⑧ 实时显示与接口</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">5 Hz DiagnosticArray → RViz健康面板；UInt8：0/1/2</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">显示频率、接收年龄、点数、IMU、定位运动/方差、代际、异常原因</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">RViz另外显示原始点云、当前帧、地图；诊断失联2 s后旧状态失效</FONT></TD></TR></TABLE>>];
logs [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD ALIGN="CENTER" BGCOLOR="#FCE7F3"><FONT POINT-SIZE="19"><B>⑧ 可追溯日志（贯穿启停与规则判断）</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">事件 JSONL：候选 / 触发 / 恢复 / 启停；指标 CSV：默认1 s采样</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">记录实例ID、数据代际、运行ID、有效配置、版本及数据/二进制哈希</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">写入失败、丢记录、删除旧日志可见；日志不完整=false 表示未发现缺失</FONT></TD></TR></TABLE>>];
note [label=<<TABLE BORDER="1" COLOR="#CBD5E1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="10"><TR><TD ALIGN="CENTER" BGCOLOR="#E8F0FE"><FONT POINT-SIZE="19"><B>适用范围与阅读说明</B></FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">图中阈值是本项目开发/回放默认值，实机部署须按设备、平台与采样率标定</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">源时间戳间隔 ≠ 接收年龄 ≠ 绝对传输延迟；频率默认不随2倍bag播放翻倍</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="16">噪声、卡死、饱和的专用标定规则尚未实现；当前异常幅值阈值不是硬件量程</FONT></TD></TR></TABLE>>];
config -> adapter -> life;
life -> stop [label="计划停止"];
life -> start [label="需要运行"];
{rank=same; stop; start;}
stop -> start [style=dashed, constraint=false, label="等待后再次 RUN"];
start -> time [label="就绪后持续检查"];
time -> lidar; time -> imu; time -> loc;
{rank=same; lidar; imu; loc;}
lidar -> latch; imu -> latch; loc -> latch;
latch -> summary;
summary -> display; summary -> logs;
{rank=same; display; logs;}
display -> note [style=invis]; logs -> note [style=invis];
}