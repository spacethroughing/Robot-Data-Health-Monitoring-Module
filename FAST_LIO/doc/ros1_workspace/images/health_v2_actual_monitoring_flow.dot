digraph G {
  graph [rankdir=TB, bgcolor="white", pad="0.35", nodesep="0.45", ranksep="0.55", splines=ortho, fontname="Noto Sans CJK SC", dpi=160, labelloc=t, label="健康监控工作流程", fontsize=24, fontcolor="#0F172A"];
  node [shape=box, style="rounded,filled", fillcolor="#F8FAFC", color="#94A3B8", penwidth=1.4, fontname="Noto Sans CJK SC", fontsize=16, margin="0.18,0.12"];
  edge [color="#64748B", fontname="Noto Sans CJK SC", fontsize=12, arrowsize=0.8];

  config [label="启动监控\n读取 YAML 配置", fillcolor="#FEF3C7", color="#D97706"];
  input [label="接收数据\n雷达 · IMU · 定位", fillcolor="#E0F2FE", color="#0284C7"];
  adapter [label="整理数据\n统一消息格式、单位和坐标"];
  { rank=same;
    lidar [label="雷达检查\n点数 · 有效率 · 频率 · 时间", fillcolor="#DBEAFE", color="#2563EB"];
    imu [label="IMU 检查\n加速度 · 角速度 · 时间", fillcolor="#CCFBF1", color="#0F766E"];
    loc [label="定位检查\n时间 · 速度 · 加速度 · 协方差 · 跳变", fillcolor="#EDE9FE", color="#7C3AED"];
  }
  probe [label="时间探针\n持续计算距上次收到数据多久", fillcolor="#FEF3C7", color="#D97706"];
  summary [label="汇总健康状态\nOK · WARNING · ERROR", fillcolor="#EDE9FE", color="#7C3AED"];
  output [label="实时显示并保存记录\nRViz 面板 · ROS 诊断 · JSONL 事件 · CSV 指标", fillcolor="#DCFCE7", color="#16A34A"];

  config -> input -> adapter;
  adapter -> lidar;
  adapter -> imu;
  adapter -> loc;
  input -> probe;
  lidar -> summary;
  imu -> summary;
  loc -> summary;
  probe -> summary;
  summary -> output;
  { rank=same; lidar; imu; loc; probe; }
}
